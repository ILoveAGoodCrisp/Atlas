{
    "name": "atlas",
    "displayName": "HaloScript",
    "publisher": "Crisp",
    "author": {
        "name": "Crisp"
    },
    "description": "HaloScript provides comprehensive language support for the Halo Scripting language used in the Halo: MCC Mod Tools",
    "keywords": [
        "hsc",
        "haloscript",
        "language",
        "blamscript",
        "haloce",
        "halo1",
        "mcc",
        "halo 2",
        "halo 3",
        "halo odst",
        "halo reach",
        "odst",
        "reach",
        "halo 4",
        "halo 2a",
        "atlas",
        "halo script",
        "halo mod tools"
    ],
    "galleryBanner": {
        "color": "#eff1f3",
        "theme": "light"
    },
    "version": "2.4.2",
    "license": "MIT",
    "icon": "icons/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/ILoveAGoodCrisp/Atlas"
    },
    "engines": {
        "vscode": "^1.105.0",
        "node": "^20.5.1"
    },
    "main": "./out/extension",
    "activationEvents": [],
    "categories": [
        "Programming Languages",
        "Language Packs"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "HaloScript language features remain available, but compiling is disabled because it runs Halo Editing Kit tool.exe.",
            "restrictedConfigurations": [
                "atlas.compiler.editingKitPaths"
            ]
        },
        "virtualWorkspaces": {
            "supported": true,
            "description": "Language features work in virtual workspaces. Compiling requires a saved local Windows file."
        }
    },
    "contributes": {
        "commands": [
            {
                "command": "atlas.compileScenarioScripts",
                "title": "HaloScript: Compile Scenario Scripts",
                "shortTitle": "Compile Scripts",
                "icon": "$(tools)",
                "enablement": "atlas.compiler.activeScriptCanCompile"
            },
            {
                "command": "atlas.compileScenarioScripts.chooseScenario",
                "title": "HaloScript: Compile Scenario Scripts (Choose Scenario)",
                "shortTitle": "Choose Scenario and Compile",
                "icon": "$(list-selection)",
                "enablement": "atlas.compiler.activeScriptCanCompile"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "atlas.compileScenarioScripts",
                    "when": "editorLangId == hsc1 || editorLangId == hsc2 || editorLangId == hsc3 || editorLangId == hsco || editorLangId == hscr || editorLangId == hsc4"
                },
                {
                    "command": "atlas.compileScenarioScripts.chooseScenario",
                    "when": "editorLangId == hsc1 || editorLangId == hsc2 || editorLangId == hsc3 || editorLangId == hsco || editorLangId == hscr || editorLangId == hsc4"
                }
            ],
            "editor/context": [
                {
                    "command": "atlas.compileScenarioScripts",
                    "group": "1_modification@10",
                    "when": "resourceScheme == file && resourceExtname == .hsc && isWorkspaceTrusted && (editorLangId == hsc1 || editorLangId == hsc2 || editorLangId == hsc3 || editorLangId == hsco || editorLangId == hscr || editorLangId == hsc4)"
                },
                {
                    "command": "atlas.compileScenarioScripts.chooseScenario",
                    "group": "1_modification@11",
                    "when": "resourceScheme == file && resourceExtname == .hsc && isWorkspaceTrusted && (editorLangId == hsc1 || editorLangId == hsc2 || editorLangId == hsc3 || editorLangId == hsco || editorLangId == hscr || editorLangId == hsc4)"
                }
            ],
            "editor/title": [
                {
                    "command": "atlas.compileScenarioScripts",
                    "group": "navigation@10",
                    "when": "resourceScheme == file && resourceExtname == .hsc && isWorkspaceTrusted && (editorLangId == hsc1 || editorLangId == hsc2 || editorLangId == hsc3 || editorLangId == hsco || editorLangId == hscr || editorLangId == hsc4)"
                }
            ]
        },
        "configuration": {
            "title": "HaloScript",
            "properties": {
                "atlas.compiler.autoDetectScriptLanguage": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "description": "Automatically switch each saved .hsc document to the HaloScript language for the Editing Kit that contains it. Compiler selection still uses the detected Editing Kit when this is disabled."
                },
                "atlas.compiler.autoDetectEditingKits": {
                    "type": "boolean",
                    "default": true,
                    "scope": "machine",
                    "description": "Automatically find installed Halo Editing Kits from Steam libraries."
                },
                "atlas.compiler.editingKitPaths": {
                    "type": "object",
                    "default": {},
                    "scope": "machine",
                    "description": "Optional Editing Kit root folders. Each folder must contain tool.exe.",
                    "properties": {
                        "hsc1": {
                            "type": "string",
                            "description": "Halo 1 Editing Kit root (usually HCEEK)."
                        },
                        "hsc2": {
                            "type": "string",
                            "description": "Halo 2 Editing Kit root (usually H2EK)."
                        },
                        "hsc3": {
                            "type": "string",
                            "description": "Halo 3 Editing Kit root (usually H3EK)."
                        },
                        "hsco": {
                            "type": "string",
                            "description": "Halo 3: ODST Editing Kit root (usually H3ODSTEK)."
                        },
                        "hscr": {
                            "type": "string",
                            "description": "Halo: Reach Editing Kit root (usually HREK)."
                        },
                        "hsc4": {
                            "type": "string",
                            "description": "Halo 4 Editing Kit root (usually H4EK)."
                        },
                        "h2amp": {
                            "type": "string",
                            "description": "Halo 2 Anniversary MP Editing Kit root (usually H2AMPEK). Uses the Halo 4 language."
                        }
                    },
                    "additionalProperties": false
                },
                "atlas.compiler.saveBeforeCompile": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "description": "Save all dirty .hsc files in the same scripts folder before running tool.exe."
                }
            }
        },
        "languages": [
            {
                "id": "hsc4",
                "aliases": [
                    "Halo 4 Script",
                    "HaloScript"
                ],
                "extensions": [
                    ".hsc"
                ],
                "configuration": "./new-config.json",
                "icon": {
                    "dark": "./icons/h4.svg",
                    "light": "./icons/h4.svg"
                }
            },
            {
                "id": "hscr",
                "aliases": [
                    "Halo Reach Script",
                    "HaloScript"
                ],
                "extensions": [
                    ".hsc"
                ],
                "configuration": "./classic-config.json",
                "icon": {
                    "dark": "./icons/hr.svg",
                    "light": "./icons/hr.svg"
                }
            },
            {
                "id": "hsco",
                "aliases": [
                    "Halo ODST Script",
                    "HaloScript"
                ],
                "extensions": [
                    ".hsc"
                ],
                "configuration": "./classic-config.json",
                "icon": {
                    "dark": "./icons/h3o.svg",
                    "light": "./icons/h3o.svg"
                }
            },
            {
                "id": "hsc3",
                "aliases": [
                    "Halo 3 Script",
                    "HaloScript"
                ],
                "extensions": [
                    ".hsc"
                ],
                "configuration": "./classic-config.json",
                "icon": {
                    "dark": "./icons/h3.svg",
                    "light": "./icons/h3.svg"
                }
            },
            {
                "id": "hsc2",
                "aliases": [
                    "Halo 2 Script",
                    "HaloScript"
                ],
                "extensions": [
                    ".hsc"
                ],
                "configuration": "./classic-config.json",
                "icon": {
                    "dark": "./icons/h2.svg",
                    "light": "./icons/h2.svg"
                }
            },
            {
                "id": "hsc1",
                "aliases": [
                    "Halo 1 Script",
                    "HaloScript"
                ],
                "extensions": [
                    ".hsc"
                ],
                "configuration": "./classic-config.json",
                "icon": {
                    "dark": "./icons/h1.svg",
                    "light": "./icons/h1.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "hsc4",
                "scopeName": "source.hsc4",
                "path": "./syntaxes/hsc4.tmLanguage.json"
            },
            {
                "language": "hscr",
                "scopeName": "source.hscr",
                "path": "./syntaxes/hscr.tmLanguage.json"
            },
            {
                "language": "hsco",
                "scopeName": "source.hsco",
                "path": "./syntaxes/hsco.tmLanguage.json"
            },
            {
                "language": "hsc3",
                "scopeName": "source.hsc3",
                "path": "./syntaxes/hsc3.tmLanguage.json"
            },
            {
                "language": "hsc2",
                "scopeName": "source.hsc2",
                "path": "./syntaxes/hsc2.tmLanguage.json"
            },
            {
                "language": "hsc1",
                "scopeName": "source.hsc1",
                "path": "./syntaxes/hsc1.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "scope": "hsc4",
                "language": "hsc4",
                "path": "./snippets/H4.json"
            },
            {
                "scope": "hscr",
                "language": "hscr",
                "path": "./snippets/HR.json"
            },
            {
                "scope": "hsco",
                "language": "hsco",
                "path": "./snippets/HO.json"
            },
            {
                "scope": "hsc3",
                "language": "hsc3",
                "path": "./snippets/H3.json"
            },
            {
                "scope": "hsc2",
                "language": "hsc2",
                "path": "./snippets/H2.json"
            },
            {
                "scope": "hsc1",
                "language": "hsc1",
                "path": "./snippets/H1.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "tsc -p ./ && node --test test/compilerCore.test.js",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^20.17.0",
        "@types/vscode": "^1.105.0",
        "esbuild": "^0.19.3",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "vsce": "^2.15.0",
        "vscode-languageserver": "^8.1.0",
        "vscode-languageserver-textdocument": "^1.0.8"
    }
}
